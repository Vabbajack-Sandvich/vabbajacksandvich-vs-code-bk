}


;=====================================================================

;z file no space
;remove spaces in file names
;general usage

zfns(zfnsdir, zfnsext)
{
	if (zfnsdir = "") {
		return
	}
global zflal := []
zfl(zfnsdir, zfnsext)
	if (zflal.length = 0) {
		return
	}
zfnsint := 1
zfnsstop := 0
zfnsfn := ""
zfnsts := ""
	while zfnsstop = 0 {
		zfnsfn := zflal.get(zfnsint)
		zfnsts := strreplace(zfnsfn, " ", "-")
		zfm(zfnsdir "\" zfnsfn, zfnsdir "\" zfnsts)
		if (zfnsint = zflal.length) {
			zfnsstop := 1
		}
		zfnsint := zfnsint + 1
	}
return
}


