;then incriments zindex2
;this is specifically for oblivion spells
;so it doesnt do the new line check

;dot on the num pad no modifier buttons
zsendslineitemaddsdashzindex2()
{
global lines
global zindex
global zindex2
global zmsg
	if (lines.length = 0) {
		return
	}
	
	zlen := StrLen(lines[zindex])
	ztrim := SubStr(lines[zindex], 1, zlen - 1)
	sleep 1000
	;sendinput ztrim "-" zindex2
	sendevent ztrim "-" zindex2
	zindex2 := zindex2 + 1
	
	zwmsg(zindex "-" zindex2)
	
return
}


