;makes a ffmpe comman list with *.mp4 in zffm.txt

zffm()
{
	
	;check to see if the windows explorer is active
	zvcwindow := zwa("vc")
		if (zvcwindow = "") {
			zwafs()
			zwmsg("zffm - zvcwindow - vc window not active")
			return
		}
		
	;global array for file list functions
	;clear it
	global zflal := []
	
	;remove spaces in file names first
	;z file no space
	zfns("d:\vc", "*.mp4")
	
	;just use the z file to list function for the zfilelist
	zftl("d:\vc", "*.mp4")
		if (zflal.length = 0) {
			zwafs()
			zwmsg("zffm - zftl - no files in VC")
			return
		}
	;convert to ffmpeg cmd prompt commands
	;index for iterating through list
	zffi := 1
	zffstop := 0
	zffplstr := "rem just edit the ss and t values for all mp4s in d:\vc\`n"
	
	if (zflal.length = 1) {
		zffn := zflal.get(zffi)
		;NewStr := SubStr(String, StartingPos , Length)
		;have to trim the extention
		zffn2 := substr(zffn, 1, strlen(zffn) - 4)
		zffn2 := strreplace(zffn2, " ", "-")
		zffplstr := zffplstr "`nffmpeg -y -ss 00:00:00 -to 00:00:00 -i " zffn " -c:v libx264 -crf 18 -preset ultrafast " zffn2 "_uf_trimmed-" zffi ".mp4`n"
	}
	else {
		while zffstop = 0 {
			zffn := zflal.get(zffi)
			;NewStr := SubStr(String, StartingPos , Length)
			;have to trim the extention
			zffn2 := substr(zffn, 1, strlen(zffn) - 4)
			zffn2 := strreplace(zffn2, " ", "-")
			if (zffi = 1) {
				;zffplstr := "ffmpeg -y -ss 00:00:00 -t 00:00:00 -i " zffn " -c:v libx264 -crf 18 -preset ultrafast " zffn2 "_uf_trimmed-" zffi ".mp4"
				zffplstr := "ffmpeg -y -ss 00:00:00 -to 00:00:00 -i " zffn " -c:v libx264 -crf 18 -preset ultrafast " zffn2 "_uf_trimmed-" zffi ".mp4"
			}
			else {
				;zffplstr := zffplstr "`nffmpeg -y -ss 00:00:00 -t 00:00:00 -i " zffn " -c:v libx264 -crf 18 -preset ultrafast " zffn2 "_uf_trimmed-" zffi ".mp4"
				zffplstr := zffplstr "`nffmpeg -y -ss 00:00:00 -to 00:00:00 -i " zffn " -c:v libx264 -crf 18 -preset ultrafast " zffn2 "_uf_trimmed-" zffi ".mp4"
			}
			zffi := zffi + 1
			if (zffi = zflal.length) {
				zffn := zflal.get(zffi)
				zffn2 := substr(zffn, 1, strlen(zffn) - 4)
				zffn2 := strreplace(zffn2, " ", "-")
				zffstop := 1
				;zffplstr := zffplstr "`nffmpeg -y -ss 00:00:00 -t 00:00:00 -i " zffn " -c:v libx264 -crf 18 -preset ultrafast " zffn2 "_uf_trimmed-" zffi ".mp4`n"
				zffplstr := zffplstr "`nffmpeg -y -ss 00:00:00 -to 00:00:00 -i " zffn " -c:v libx264 -crf 18 -preset ultrafast " zffn2 "_uf_trimmed-" zffi ".mp4`n"
			}
		}
	;end of else
	}
	
	;write the file
	zwf("D:\vc\zffm.bat", zffplstr)

	return
}


