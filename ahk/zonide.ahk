	;following:
	;R = READONLY
	;A = ARCHIVE
	;S = SYSTEM
	;H = HIDDEN
	;N = NORMAL
	;D = DIRECTORY
	;O = OFFLINE
	;C = COMPRESSED
	;T = TEMPORARY
	;L = REPARSE_POINT (typically a symbolic link)
	;If the file has no attributes (rare), "X" is returned. If no file or
	;folder is found, an empty string is returned.

