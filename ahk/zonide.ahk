;=====================================================================

;this was the code in the R button
;it generates a 6 digit hex code
;im putting it in the function instead
zgenrandhex()
{
;this the global that the program uses
;to output the last randomly generated string
global zrandhex

;randdig is the digit from 1 to 6 for the hex code
;for the loop that iterates through the digits
;then generates a random number or letter
;then adds it to the end of the global zrandhex

;this count the passes of the loop which
;incriments the digit place, until it hits
;37 at which point it stops the loop
zrandinc := 1

;this is the loops random number from 1 to 36
;which the swich case thing uses to append
;an alpha numeric character based on which number matched
;which case, to the the global zrandhex
;by using itself to add to the end
randdig := 0

;this controls the loop
;if it is not 0 it will stop
zrandstop := 0

;reset zrandhex
zrandhex := ""

	while zrandstop = 0 {
		zranddig := Random(0, 15)
		Switch zranddig
			{
			Case 0:
				;0
				zrandhex := zrandhex "0"
			Case 1:
				;1
				zrandhex := zrandhex "1"
			Case 2:
				;2
				zrandhex := zrandhex "2"
			Case 3:
				;3
				zrandhex := zrandhex "3"
			Case 4:
				;4
				zrandhex := zrandhex "4"
			Case 5:
				;5
				zrandhex := zrandhex "5"
			Case 6:
				;6
				zrandhex := zrandhex "6"
			Case 7:
				;7
				zrandhex := zrandhex "7"
			Case 8:
				;8
				zrandhex := zrandhex "8"
			Case 9:
				;9
				zrandhex := zrandhex "9"
			Case 10:
				;A
				zrandhex := zrandhex "A"
			Case 11:
				;B
				zrandhex := zrandhex "B"
			Case 12:
				;C
				zrandhex := zrandhex "C"
			Case 13:
				;D
				zrandhex := zrandhex "D"
			Case 14:
				;E
				zrandhex := zrandhex "E"
			Case 15:
				;F
				zrandhex := zrandhex "F"
			;last select brace
			}
				
		if (zrandinc < 6)
		{
			zrandinc := zrandinc + 1
		}
		else {
			;stop the loop
			zrandstop := 1
		}
	;end loop brace
	}
;end of zgenrandhex
}


