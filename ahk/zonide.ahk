;=====================================================================

;this sanitizes inputs for numbers only
;then returns the numbers only
;global znumfilter := ""

numfilter(znumfilter)
{
	znumtemp2 := znumfilter
	if (znumtemp2 = "") {
		return
	}
;	if (znumtemp2 = "0") {
;		return
;	}

	;this a temp string is for the output
	znumtemp := ""
	
	;znflen is z num filter length from the input
	znflen := StrLen(znumtemp2)
	
	;this is the temp for loop value
	znti := "1"
	
	;to stop the while loop at the end
	;of going through each letter
	znumstop := 0
	
	;need a temp string to iterate with
	ztscs := ""
	
	while znumstop = 0 {
		ztscs := SubStr(znumtemp2, znti, 1)
		Switch ztscs
		{
				Case "0":
					;0
					znumtemp := znumtemp "0"
				Case "1":
					;1
					znumtemp := znumtemp "1"
				Case "2":
					;2
					znumtemp := znumtemp "2"
				Case "3":
					;3
					znumtemp := znumtemp "3"
				Case "4":
					;4
					znumtemp := znumtemp "4"
				Case "5":
					;5
					znumtemp := znumtemp "5"
				Case "6":
					;6
					znumtemp := znumtemp "6"
				Case "7":
					;7
					znumtemp := znumtemp "7"
				Case "8":
					;8
					znumtemp := znumtemp "8"
				Case "9":
					;9
					znumtemp := znumtemp "9"
		;end brace for switch znumfilter
		}
		;incriment the index
		znti := znti + 1
		if (znti = znflen + 1) {
			znumstop := 1
		}
	;end brace for for loop znti
	}
	return znumtemp
	;znumfilter := znumtemp
;end brace for numfilter
}


